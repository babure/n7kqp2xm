# Analysis window (change these to extend beyond January 2026)
GRIDBRICKS_DELIVERY_FROM=2026-01-01
GRIDBRICKS_DELIVERY_TO=2026-01-31
GRIDBRICKS_LABEL=Jan 2026 · GB wind

# Day-ahead gate (Europe/London on D-1)
GRIDBRICKS_GATE_HOUR=9
GRIDBRICKS_GATE_MINUTE=50

# WINDFOR publish fetch padding around the delivery window
GRIDBRICKS_PUBLISH_LEAD_DAYS=2
GRIDBRICKS_PUBLISH_LAG_DAYS=1

# Runtime
CACHE_DIR=backend/data/cache
STATIC_DIR=frontend/dist
SKIP_COLD_REFRESH=0
CORS_ORIGINS=*
PORT=8000

# Frontend (optional; leave empty for same-origin / Vite proxy)
# VITE_API_BASE=
